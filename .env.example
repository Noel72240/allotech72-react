# Copier vers .env et remplir (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optionnel : préremplit l’email sur /admin (pas secret)
# VITE_ADMIN_EMAIL=contact@exemple.fr

# Google Analytics 4 — mesure d’audience (chargé uniquement après consentement cookies)
VITE_GA_MEASUREMENT_ID=G-5Q6TJZHVVG

# SumUp — paiement en ligne (API route Vercel uniquement, jamais côté navigateur)
# SUMUP_API_KEY=sup_sk_...
# SUMUP_MERCHANT_CODE=MH4H92C7

# Stock boutique après paiement (API sumup-complete — jamais côté navigateur)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_URL=https://xxxx.supabase.co

# ── Adam — Agent IA (Edge Functions Supabase uniquement, jamais côté navigateur) ──
# Secrets à configurer dans Supabase → Edge Functions → Secrets :
# OPENAI_API_KEY=sk-...
# ADAM_LLM_PROVIDER=openai
# ADAM_LLM_MODEL=gpt-4o
# ADAM_LLM_EMBEDDING_MODEL=text-embedding-3-small
# ADAM_ALLOWED_ORIGINS=https://www.allotech72.fr,https://allotech72.fr,http://localhost:5173
# ADAM_EMBED_SECRET=secret-pour-indexation-rag
# ADAM_MAX_TOOL_ITERATIONS=5
# ADAM_RAG_TOP_K=5
# ADAM_RATE_LIMIT_PER_HOUR=30
# Le front utilise uniquement VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (déjà ci-dessus).

# Email notification commande boutique (Formspree — même ID que contact ou formulaire dédié)
# FORMSPREE_ID=xlgpqnrl

# Email confirmation CLIENT après paiement (2e formulaire Formspree, réponse auto activée)
# Formspree → Autoresponse → Custom : « Bonjour,\n\n{{ message }}\n\nCordialement,\nAllotech72 »
# Désactiver la notification vendeur sur CE formulaire.
# FORMSPREE_CUSTOMER_ID=xxxxxxxx
