{
  "redirects": [
    { "source": "/vente", "destination": "/boutique", "permanent": true },
    { "source": "/vente/occasion", "destination": "/boutique/occasion", "permanent": true },
    { "source": "/vente/neuf", "destination": "/boutique/neuf", "permanent": true },
    { "source": "/vente/neuf/:categoryId", "destination": "/boutique/neuf/:categoryId", "permanent": true }
  ],
  "rewrites": [
    { "source": "/boutique", "destination": "/boutique/index.html" },
    { "source": "/services-informatiques-sarthe", "destination": "/services-informatiques-sarthe/index.html" },
    { "source": "/depannage-informatique-le-mans", "destination": "/depannage-informatique-le-mans/index.html" },
    { "source": "/reparation-ordinateur-le-mans", "destination": "/reparation-ordinateur-le-mans/index.html" },
    { "source": "/reparateur-telephone-le-mans", "destination": "/reparateur-telephone-le-mans/index.html" },
    { "source": "/creation-site-internet-sarthe", "destination": "/creation-site-internet-sarthe/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
