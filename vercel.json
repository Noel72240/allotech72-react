{
  "redirects": [
    { "source": "/vente", "destination": "/boutique", "permanent": true },
    { "source": "/vente/occasion", "destination": "/boutique/occasion", "permanent": true },
    { "source": "/vente/neuf", "destination": "/boutique/neuf", "permanent": true },
    { "source": "/vente/neuf/:categoryId", "destination": "/boutique/neuf/:categoryId", "permanent": true },
    { "source": "/qreateur", "destination": "/qreateur/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/qreateur/", "destination": "/qreateur/index.html" },
    { "source": "/qreateur/merci", "destination": "/qreateur/merci.html" },
    { "source": "/qreateur/merci.html", "destination": "/qreateur/merci.html" },
    { "source": "/qreateur/aide-smartscreen", "destination": "/qreateur/aide-smartscreen.html" },
    { "source": "/qreateur/aide-smartscreen.html", "destination": "/qreateur/aide-smartscreen.html" },
    { "source": "/boutique", "destination": "/boutique/index.html" },
    { "source": "/services-informatiques-sarthe", "destination": "/services-informatiques-sarthe/index.html" },
    { "source": "/depannage-informatique-le-mans", "destination": "/depannage-informatique-le-mans/index.html" },
    { "source": "/reparation-ordinateur-le-mans", "destination": "/reparation-ordinateur-le-mans/index.html" },
    { "source": "/reparateur-telephone-le-mans", "destination": "/reparateur-telephone-le-mans/index.html" },
    { "source": "/creation-site-internet-sarthe", "destination": "/creation-site-internet-sarthe/index.html" },
    { "source": "/outils", "destination": "/outils/index.html" },
    { "source": "/tarifs", "destination": "/tarifs/index.html" },
    { "source": "/prendre-rdv", "destination": "/prendre-rdv/index.html" },
    { "source": "/presse", "destination": "/presse/index.html" },
    { "source": "/depannage-informatique-allonnes", "destination": "/depannage-informatique-allonnes/index.html" },
    { "source": "/depannage-informatique-coulaines", "destination": "/depannage-informatique-coulaines/index.html" },
    { "source": "/depannage-informatique-champagne", "destination": "/depannage-informatique-champagne/index.html" },
    { "source": "/depannage-informatique-arnage", "destination": "/depannage-informatique-arnage/index.html" },
    { "source": "/depannage-informatique-la-fleche", "destination": "/depannage-informatique-la-fleche/index.html" },
    { "source": "/depannage-informatique-sable-sur-sarthe", "destination": "/depannage-informatique-sable-sur-sarthe/index.html" },
    { "source": "/partenaires", "destination": "/partenaires/index.html" },
    { "source": "/((?!api/|qreateur).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
